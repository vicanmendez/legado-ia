# ==============================================================================
# legado-ia - Plantilla de Configuración (.env.example)
# ==============================================================================
# IMPORTANTE: Copiar a .env para desarrollo local. JAMÁS versionar el archivo .env
# En producción (APP_ENV=production), la aplicación aborta el arranque (fail-fast)
# si falta cualquier secreto obligatorio, si APP_SECRET_KEY < 32 bytes o si
# APP_BASE_URL no comienza con https://
# ==============================================================================

# Entorno de ejecución: development | testing | production
APP_ENV=development
APP_BASE_URL=http://localhost:8000
APP_SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_32_BYTES_RANDOM_SECRET_KEY

# Motor de Base de Datos: sqlite | mysql
DB_ENGINE=sqlite
DB_SQLITE_PATH=./legado.db

# Configuración MySQL / MariaDB (obligatoria si DB_ENGINE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=legado_ia
DB_USER=legado_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
# Obligatorio en producción si DB_HOST no es localhost/127.0.0.1
DB_SSL_CA=

# Cifrado por Sobre AES-256-GCM (KEK)
# En producción usar ENCRYPTION_KEK_FILE apuntando a un Docker secret (32 bytes en base64)
ENCRYPTION_KEK_FILE=
# ENCRYPTION_KEK en línea solo se permite cuando APP_ENV != production
ENCRYPTION_KEK=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Almacenamiento de archivos de audio cifrados en disco
AUDIO_STORAGE_PATH=./data/audio

# Configuración SMTP Genérica (aiosmtplib)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=no-reply@legado-ia.local

# Captcha ALTCHA autoalojado (clave HMAC de al menos 32 caracteres)
ALTCHA_HMAC_KEY=CHANGE_ME_ALTCHA_HMAC_SECRET_KEY_MIN_32_CHARS

# WebAuthn / Passkeys (FIDO2)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Legado IA

# Proveedor LLM compatible con OpenAI (Ollama por defecto, OpenRouter opcional)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=

# Modelo local de transcripción de voz (faster-whisper)
WHISPER_MODEL=base
